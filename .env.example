# Server Configuration
HOST=0.0.0.0
PORT=8085
BASE_URL=https://pay.rapidx.me
ENVIRONMENT=production
DEBUG=false

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=clusterpay_db

# Default Gateway Wallets (Merchants can override these per checkout API call)
DEFAULT_USDT_BEP20_WALLET=0x0000000000000000000000000000000000000000
DEFAULT_USDT_TRC20_WALLET=TXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DEFAULT_USDT_POLY_WALLET=0x0000000000000000000000000000000000000000
DEFAULT_USDT_ARB_WALLET=0x0000000000000000000000000000000000000000
DEFAULT_TON_WALLET=UQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
DEFAULT_LTC_WALLET=LTC1QAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
DEFAULT_BTC_WALLET=bc1qAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
DEFAULT_POL_WALLET=0x0000000000000000000000000000000000000000

# Blockchain Explorer & Indexer API Keys (Optional for enhanced RPC rate limits)
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
TRONSCAN_API_KEY=
TONCENTER_API_KEY=

# Security & Anti-Theft Policies
RATE_LIMIT_PER_MINUTE=60
INVOICE_EXPIRATION_MINUTES=15
MAX_TX_AGE_SECONDS=7200

# ClusterPay Server Configuration
HOST=0.0.0.0
PORT=8085
BASE_URL=https://pay.yourstore.com
ENVIRONMENT=production
DEBUG=false

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=clusterpay_db

# Security & Master Admin Key
ADMIN_MASTER_KEY=cpay_master_admin_secret_key_change_me
RATE_LIMIT_PER_MINUTE=60

# Blockchain RPC API Keys (Optional for higher throughput)
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
TRONSCAN_API_KEY=
TONCENTER_API_KEY=
